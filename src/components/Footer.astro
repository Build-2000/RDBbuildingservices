---
import { services } from '../data/services';
import { business } from '../data/business.mjs';
import '../styles/footer.css';
---
<footer class="site-footer">
  <div class="footer-invitation">
    <div class="wrap footer-invitation-inner">
      <div><p class="footer-kicker">YOUR NEXT SPACE STARTS HERE</p><h2>Let’s make room<br/>for your next idea.</h2></div>
      <a class="footer-project-link" href="/contact/"><span>Discuss your project</span><span aria-hidden="true">↗</span></a>
    </div>
  </div>
  <div class="wrap footer-main-grid">
    <div class="footer-identity">
      <a href="/" aria-label="RDB Building Services LTD home"><img src="/images/rdb-logo.png" alt="RDB Building Services LTD" width="496" height="123" loading="lazy"/></a>
      <p>Spaces for life.<br/>Built for business.</p>
      <span class="footer-location">Sutton Coldfield · West Midlands</span>
    </div>
    <div class="footer-link-column"><h2>Our expertise</h2><ul>{services.map(s=><li><a href={`/services/${s.slug}/`}>{s.name}</a></li>)}</ul></div>
    <div class="footer-link-column"><h2>Discover RDB</h2><ul><li><a href="/#about">About us</a></li><li><a href="/#gallery">Project inspiration</a></li><li><a href="/#faq">Your questions</a></li><li><a href="/contact/">Contact us</a></li></ul></div>
    <div class="footer-contact-column"><h2>Start a conversation</h2><a class="footer-email" href={`mailto:${business.email}`}>info@<wbr/>rdbbuildingservices.co.uk <span aria-hidden="true">↗</span></a><address>Unit 1, Newlands Farm<br/>Newlands Lane, Curdworth<br/>Sutton Coldfield B76 0BE<br/>United Kingdom</address><a class="footer-directions" href="https://www.google.com/maps/search/?api=1&query=Unit+1+Newlands+Farm+Newlands+Lane+Curdworth+B76+0BE" target="_blank" rel="noopener noreferrer">Find us <span aria-hidden="true">↗</span></a></div>
  </div>
  <div class="footer-disclosures"><div class="wrap footer-disclosures-inner"><p><strong>{business.legalName}</strong><br/>Registered in {business.registration} · Company no. <a href={business.record} target="_blank" rel="noopener noreferrer">{business.companyNumber}</a></p><p><span>Registered office</span><br/>{business.registeredOffice}</p></div></div>
  <div class="wrap footer-utility"><p>© RDB Building Services LTD</p><ul aria-label="Legal information"><li><a href="/terms-and-conditions/">Terms &amp; Conditions</a></li><li><a href="/privacy-policy/">Privacy</a></li><li><a href="/cookie-policy/">Cookies</a></li></ul><a class="footer-top" href="#main">Back to top <span aria-hidden="true">↑</span></a></div>
</footer>
