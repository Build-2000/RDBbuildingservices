---
import {business as company} from '../data/business.mjs';
interface Props { title: string; description: string; image?: string; service?: string; }
const {title, description, image='/images/rdb-stock-1.jpg', service}=Astro.props;
const canonical=Astro.site ? new URL(Astro.url.pathname,Astro.site).href : undefined;
const business={ '@type':'LocalBusiness', name:company.name, legalName:company.legalName, identifier:company.companyNumber, email:company.email, address:{'@type':'PostalAddress',streetAddress:'Unit 1, Newlands Farm, Newlands Lane, Curdworth',addressLocality:'Sutton Coldfield',addressRegion:'West Midlands',postalCode:'B76 0BE',addressCountry:'GB'},...(Astro.site ? {url:Astro.site.href,image:new URL('/images/rdb-logo.png',Astro.site).href}: {})};
const graph:any[]=[business];
if(service)graph.push({'@type':'Service',name:service,description,provider:business,...(canonical?{url:canonical}: {})});
if(canonical && Astro.url.pathname.startsWith('/services/'))graph.push({'@type':'BreadcrumbList',itemListElement:[{'@type':'ListItem',position:1,name:'Home',item:Astro.site!.href},{'@type':'ListItem',position:2,name:'Services',item:new URL('/services/',Astro.site!).href},...(service?[{'@type':'ListItem',position:3,name:service,item:canonical}]:[])]});
---
<link rel="preload" href="/fonts/inter-latin-variable.woff2" as="font" type="font/woff2" crossorigin="anonymous"/><link rel="preload" href="/fonts/plus-jakarta-sans-latin-variable.woff2" as="font" type="font/woff2" crossorigin="anonymous"/>
<title>{title}</title><meta name="description" content={description}/><meta name="robots" content={import.meta.env.PROD && Astro.site?'index,follow':'noindex,follow'}/>{canonical && <link rel="canonical" href={canonical}/>}<meta property="og:type" content="website"/><meta property="og:locale" content="en_GB"/><meta property="og:site_name" content="RDB Building Services LTD"/><meta property="og:title" content={title}/><meta property="og:description" content={description}/>{canonical && <meta property="og:url" content={canonical}/>}<meta property="og:image" content={Astro.site?new URL(image,Astro.site).href:image}/><meta name="twitter:card" content="summary_large_image"/><meta name="twitter:title" content={title}/><meta name="twitter:description" content={description}/><script type="application/ld+json" set:html={JSON.stringify({'@context':'https://schema.org','@graph':graph}).replace(/</g,'\u003c')}/>
