---
import Page from '../layouts/Page.astro';
import {services} from '../data/services';
import {business} from '../data/business.mjs';
---
<Page title="Contact RDB Building Services | Sutton Coldfield" description="Discuss your modular building, garden room, office or container conversion with RDB in Sutton Coldfield. Prepare a project enquiry or contact us by email.">
<section class="wrap service-intro"><div class="breadcrumbs"><a href="/">Home</a><span>/</span><span>Contact</span></div><p class="eyebrow">RDB BUILDING SERVICES LTD</p><h1>Your idea.<br/><em>Let’s take it further.</em></h1><p class="lead">Tell us what you need your space to do. A few practical details will help start a useful conversation.</p></section>
<section class="wrap contact-page-grid"><div class="contact-page-info"><p class="eyebrow">START A CONVERSATION</p><h2>A clearer brief.<br/>A better starting point.</h2><p>Whether you are planning a garden office, catering kiosk or a modular space for your business, share your priorities with RDB.</p><a class="contact-page-email" href={`mailto:${business.email}`}>{business.email} ↗</a><h3>Our business location</h3><address>Unit 1, Newlands Farm, Newlands Lane,<br/>The Royal Town of Sutton Coldfield, Curdworth,<br/>Sutton Coldfield B76 0BE,<br/>United Kingdom</address><a class="inline-link" href="https://www.google.com/maps/search/?api=1&query=Unit+1+Newlands+Farm+Newlands+Lane+Curdworth+B76+0BE" target="_blank" rel="noopener noreferrer">Find us on the map ↗</a><p class="contact-phone">Telephone: coming soon</p><div class="contact-preparation"><h3>Useful details to include</h3><ul><li>The intended use and approximate dimensions</li><li>Your site postcode and available access</li><li>Preferred layout, finish and utilities</li><li>Your budget and target timescale</li></ul></div></div>
<form id="contact-enquiry" class="contact-page-form"><p class="eyebrow">TELL US ABOUT YOUR PROJECT</p><h2>Make an enquiry</h2><p class="form-note">Complete your brief below. “Open enquiry in email” opens your email app with a draft for you to review and send. Nothing is submitted automatically.</p><div class="form-row"><label>Your name *<input name="name" autocomplete="name" maxlength="100" required placeholder="Full name"/></label><label>Email address *<input name="email" type="email" autocomplete="email" maxlength="180" required placeholder="you@example.com"/></label></div><div class="form-row"><label>Telephone (optional)<input type="tel" name="phone" autocomplete="tel" maxlength="40" placeholder="Your contact number"/></label><label>UK site postcode<input name="postcode" autocomplete="postal-code" maxlength="12" placeholder="e.g. B76 0BE"/></label></div><label>Service<select name="service"><option value="">Please select</option>{services.map(s=><option value={s.slug}>{s.name}</option>)}<option value="other">Something else / advice choosing</option></select></label><div class="form-row"><label>Approximate budget (£)<input name="budget" maxlength="100" placeholder="Your budget or not yet decided"/></label><label>Preferred timescale<input name="timescale" maxlength="100" placeholder="Your preferred timescale"/></label></div><label>Your project *<textarea name="message" rows="6" minlength="10" maxlength="2500" required placeholder="Tell us how you will use the space, its approximate size, site access and any particular requirements."></textarea></label><p class="form-note">Your entries stay in this page until you choose to open an email draft or download a brief. If you send an email, RDB receives the information you include. Read our <a href="/privacy-policy/">Privacy Policy</a>.</p><button class="button" type="submit">Open enquiry in email <span>↗</span></button><button class="brief-download" type="submit" name="action" value="download">Download brief instead ↓</button><p id="contact-status" role="status" aria-live="polite"></p><noscript><p>To enquire, email <a href={`mailto:${business.email}`}>{business.email}</a> directly. The brief builder requires JavaScript.</p></noscript></form></section>
</Page>
<script>
const form=document.querySelector<HTMLFormElement>('#contact-enquiry');const selected=new URLSearchParams(window.location.search).get('service');const select=form?.querySelector<HTMLSelectElement>('select[name=service]');if(select && selected && [...select.options].some(o=>o.value===selected))select.value=selected;
form?.addEventListener('submit',event=>{event.preventDefault();const data=new FormData(form);const service=select?.selectedOptions[0]?.textContent||'General enquiry';const brief=`RDB Building Services LTD — Project enquiry\n\nName: ${data.get('name')}\nEmail: ${data.get('email')}\nTelephone: ${data.get('phone')||'Not supplied'}\nSite postcode: ${data.get('postcode')||'Not supplied'}\nService: ${service}\nBudget: ${data.get('budget')||'Not decided'}\nTimescale: ${data.get('timescale')||'Not specified'}\n\nProject details:\n${data.get('message')}`;const status=document.querySelector('#contact-status');if((event.submitter as HTMLButtonElement)?.value==='download'){const url=URL.createObjectURL(new Blob([brief],{type:'text/plain;charset=utf-8'}));const link=document.createElement('a');link.href=url;link.download='RDB-project-enquiry.txt';link.click();setTimeout(()=>URL.revokeObjectURL(url),1000);if(status)status.textContent='Your brief has been downloaded. Email it to info@rdbbuildingservices.co.uk when you are ready; nothing has been sent.';}else{const mailto=`mailto:info@rdbbuildingservices.co.uk?subject=${encodeURIComponent(`Project enquiry: ${service}`)}&body=${encodeURIComponent(brief)}`;window.location.href=mailto;if(status)status.textContent='An email draft was requested. Review and send it in your email app. If no app opens, download your brief and email it to info@rdbbuildingservices.co.uk.';}});
</script>
