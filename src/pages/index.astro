---
import '../styles/global.css';
import SEO from '../components/SEO.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import {faqGroups} from '../data/faqs';
import '../styles/responsive.css';
import '../styles/typography.css';
const services = [
 ['01','Modular buildings','Practical space for your premises. Discuss dimensions, layout, insulation and finishes for your intended use.','reference-1.jpg'],
 ['02','Garden rooms','Create space for a home office, studio or garden retreat. Start with how you want to use your garden room throughout the year.','reference-2.jpg'],
 ['03','Offices','Space for your team, from a construction site office to a separate workplace. Discuss desks, lighting, heating and access.','reference-3.jpg'],
 ['04','Catering units','Explore a container café, food kiosk or bar. Discuss serving hatches, workspace and the services your operation needs.','rdb-stock-1.jpg'],
 ['05','Container conversions','Give a shipping container a new purpose. Explore doors, shutters, windows and internal layout for your business or personal use.','rdb-stock-6.jpg']
];
const slugs = ['modular-buildings','garden-rooms','offices','catering-units','container-conversions'];
const imageAlt:Record<string,string>={
'reference-1.jpg':'Grey modular building with glazed doors, roof vents and external cladding',
'reference-2.jpg':'Clad standalone building with a covered entrance, steps and glazed side door',
'reference-3.jpg':'Prefabricated building modules being assembled inside a factory',
'rdb-stock-1.jpg':'Container bar with an open serving frontage and timber decking',
'rdb-stock-6.jpg':'Dark grey converted container with a shuttered side opening and cargo doors'
};
const gallery = [ ['rdb-stock-1.jpg','Container bar with an open serving frontage and timber decking'], ['rdb-stock-2.jpg','Black shipping container fitted with a full-width roller shutter'], ['rdb-stock-3.jpg','Gold catering container with two closed serving hatches'], ['rdb-stock-4.jpg','Blue shipping containers stacked two high with closed cargo doors'], ['rdb-stock-5.jpg','Blue and white container with double doors open at both ends'], ['rdb-stock-6.jpg','Dark grey converted container with a shuttered side opening'] ];
---
<!doctype html>
<html lang="en-GB">
<head><SEO title="Modular Buildings & Container Conversions | RDB Building Services" description="Explore modular buildings, garden rooms, offices and catering units with RDB Building Services LTD in Sutton Coldfield, West Midlands." /><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><link rel="icon" href="/favicon.svg" type="image/svg+xml"/></head>
<body>
<Header />
<main id="main">
<section class="hero"><img class="hero-photo" src="/images/rdb-stock-1.jpg" alt="Shipping container converted into an outdoor bar with timber decking" fetchpriority="high"/><div class="hero-shade"></div><div class="wrap hero-content"><p class="eyebrow light">RDB BUILDING SERVICES LTD · SUTTON COLDFIELD</p><h1>Modular buildings.<br/>Container conversions.<br/><em>Your space, reimagined.</em></h1><p>Garden rooms, offices and catering units for UK homes and businesses. Explore your next project with RDB.</p><div class="actions"><a class="button" href="/contact/">Discuss your project <span>↗</span></a><a class="text-link" href="#gallery">Explore the possibilities <span>↓</span></a></div></div></section>
<div class="service-strip"><div class="wrap"><span>MODULAR BUILDINGS</span><i>+</i><span>GARDEN ROOMS</span><i>+</i><span>OFFICES</span><i>+</i><span>CATERING UNITS</span><i>+</i><span>CONTAINER CONVERSIONS</span></div></div>
<section id="about" class="section wrap about"><div><p class="eyebrow">YOUR UK BUILDING PROJECT</p><h2>Practical spaces.<br/>Personal ideas.<br/>RDB.</h2></div><div class="about-copy"><p class="lead">From a garden workspace to a container café, start with a space that works for you.</p><p>RDB Building Services LTD is based at Newlands Farm in Sutton Coldfield, West Midlands. Our focus is modular buildings, garden rooms, offices, catering units and container conversions for UK customers.</p><p>Whether you’re planning space at home or a unit for your business, tell us your intended use, site postcode and approximate dimensions. We can then discuss your requirements, preferred finish and the scope of your project.</p><a class="inline-link" href="#contact">Let’s discuss your ideas <span>↗</span></a></div></section>
<section id="services" class="section services"><div class="wrap"><div class="section-heading"><div><p class="eyebrow">FIND YOUR SPACE</p><h2>Find the right space with RDB.</h2></div><p>For homeowners, businesses<br/>and independent traders.</p></div><div class="cards">{services.map(([number,title,copy,img], index)=><article class="card"><div class="card-image"><img src={`/images/${img}`} alt={imageAlt[img] || title} loading="lazy"/></div><div class="card-content"><h3>{title}</h3><p>{copy}</p><a href={`/services/${slugs[index]}/`} aria-label={`Read about ${title.toLowerCase()}`}>Explore this service <span>↗</span></a></div></article>)}</div></div></section>
<section id="gallery" class="section wrap"><div class="section-heading"><div><p class="eyebrow">FROM CONTAINER TO SOMETHING MORE</p><h2>Inspiration for your RDB project.</h2></div><p>A closer look at containers,<br/>conversions and practical details.</p></div><div class="gallery">{gallery.map(([img,title])=><figure><img src={`/images/${img}`} alt={title} loading="lazy"/></figure>)}</div></section>
<section class="process"><div class="wrap section"><p class="eyebrow light">START WITH A CONVERSATION</p><h2>From an idea to a clear next step.</h2><div class="steps"><article><span>01 /</span><h3>Share your idea</h3><p>Tell us the intended use, approximate size, UK site postcode and preferred timescale. Photos of the location can help explain your brief.</p></article><article><span>02 /</span><h3>Explore the options</h3><p>Discuss layout, insulation, ventilation, heating and finishes. Consider access for delivery, the base and any utility connections.</p></article><article><span>03 /</span><h3>Plan what’s next</h3><p>Request a written quotation setting out the specification, VAT treatment and what is included. Confirm site preparation, delivery and installation responsibilities before ordering.</p></article></div></div></section>
<section class="section wrap project-planning"><div class="section-heading"><div><p class="eyebrow">THINKING ABOUT YOUR SITE</p><h2>A good project starts<br/>with the right questions.</h2></div><p>Useful points to discuss<br/>before agreeing your specification.</p></div><div class="planning-grid"><article><h3>Comfort &amp; everyday use</h3><p>How will you use the space in winter and summer? Include insulation, ventilation, heating and natural light in your brief.</p></article><article><h3>Access &amp; preparation</h3><p>Consider available space, access routes, ground conditions and power, water or drainage requirements. Agree who handles each part of the work.</p></article><article><h3>Permissions &amp; operation</h3><p>Check planning and building control requirements for your site. Catering operators should also check food business registration and relevant licences.</p></article></div><div class="guidance-links"><span>Useful guidance:</span><a href="https://www.planningportal.co.uk/permission/common-projects/outbuildings/" target="_blank" rel="noopener noreferrer">Garden outbuildings in England ↗</a><a href="https://www.gov.uk/guidance/food-business-registration" target="_blank" rel="noopener noreferrer">Food business registration ↗</a><a href="https://www.planningportal.co.uk/find-your-local-planning-authority" target="_blank" rel="noopener noreferrer">Find your planning authority ↗</a></div></section>
<section id="faq" class="section wrap faq-expanded"><div class="section-heading"><div><p class="eyebrow">PLAN YOUR PROJECT WITH CONFIDENCE</p><h2>Your questions,<br/>a clearer next step.</h2></div><p>From the first idea to the site details.<br/>Explore the questions that matter.</p></div><div class="faq-topic-grid">{faqGroups.map(group=><section class="faq-topic"><h3>{group.title}</h3>{group.questions.map(([question,answer])=><details><summary>{question}<span>+</span></summary><p>{answer}</p></details>)}<a class="inline-link" href={group.slug?`/services/${group.slug}/`:'/contact/'}>{group.slug?`Explore ${group.title.toLowerCase()}`:'Prepare your enquiry'} <span>↗</span></a></section>)}</div></section>
<section id="contact" class="contact section"><div class="wrap contact-grid"><div><p class="eyebrow">LET’S BUILD ON YOUR IDEA</p><h2>What do you<br/>have in mind?</h2><p>Start planning your next space with RDB Building Services LTD.</p><address>Unit 1, Newlands Farm, Newlands Lane,<br/>The Royal Town of Sutton Coldfield, Curdworth,<br/>Sutton Coldfield B76 0BE, United Kingdom</address><div class="contact-details"><p><strong>Telephone</strong><span>Coming soon</span></p><p><strong>Email</strong><a href="mailto:info@rdbbuildingservices.co.uk">info@rdbbuildingservices.co.uk</a></p></div><a class="inline-link" href="https://www.google.com/maps/search/?api=1&query=Unit+1+Newlands+Farm+Newlands+Lane+Curdworth+B76+0BE" target="_blank" rel="noopener noreferrer">Find us on the map ↗</a></div><form id="enquiry"><h3>Prepare your enquiry</h3><p class="form-note">Create and download your project brief, then email it to info@rdbbuildingservices.co.uk when you are ready. This form downloads a file; it does not send a message.</p><div class="form-row"><label>Your name<input name="name" autocomplete="name" required placeholder="Full name"/></label><label>Email address<input type="email" name="email" autocomplete="email" required placeholder="you@example.com"/></label></div><div class="form-row"><label>UK site postcode<input name="postcode" autocomplete="postal-code" placeholder="e.g. B76 0BE"/></label><label>Approximate budget (£)<input name="budget" placeholder="e.g. £15,000 or not yet decided"/></label></div><label>I’m interested in<select name="service"><option>Modular buildings</option><option>Garden rooms</option><option>Offices</option><option>Catering units</option><option>Container conversions</option><option>Something else</option></select></label><label>Tell us about your project<textarea name="message" required rows="4" placeholder="Intended use, dimensions in metres, UK site postcode, access, budget in £ and preferred timescale…"></textarea></label><button class="button" type="submit">Download enquiry brief <span>↓</span></button><p id="form-status" role="status"></p></form></div></section>
</main><Footer />
<script>
const requestedService=new URLSearchParams(window.location.search).get("service");
const serviceOptions:Record<string,string>={"modular-buildings":"Modular buildings","garden-rooms":"Garden rooms","offices":"Offices","catering-units":"Catering units","container-conversions":"Container conversions"};
const serviceSelect=document.querySelector<HTMLSelectElement>("select[name=service]");if(serviceSelect && requestedService && serviceOptions[requestedService])serviceSelect.value=serviceOptions[requestedService];

const menu=document.querySelector<HTMLButtonElement>('.menu');const nav=document.querySelector('nav');menu?.addEventListener('click',()=>{const open=menu.getAttribute('aria-expanded')!=='true';menu.setAttribute('aria-expanded',String(open));nav?.classList.toggle('open',open)});nav?.querySelectorAll('a').forEach(a=>a.addEventListener('click',()=>{nav.classList.remove('open');menu?.setAttribute('aria-expanded','false')}));
document.querySelector<HTMLFormElement>('#enquiry')?.addEventListener('submit',event=>{event.preventDefault();const data=new FormData(event.currentTarget as HTMLFormElement);const text=`RDB Building Services LTD — Enquiry brief\n\nName: ${data.get('name')}\nEmail: ${data.get('email')}\nInterest: ${data.get('service')}\nSite postcode: ${data.get('postcode')}\nBudget: ${data.get('budget')}\n\n${data.get('message')}\n\nPrepared locally. This enquiry has not been sent.`;const url=URL.createObjectURL(new Blob([text],{type:'text/plain;charset=utf-8'}));const a=document.createElement('a');a.href=url;a.download='RDB-enquiry-brief.txt';a.click();URL.revokeObjectURL(url);document.querySelector('#form-status')!.textContent='Your brief has been downloaded. No message has been sent.';});
</script></body></html>
