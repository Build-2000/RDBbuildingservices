---
import Page from '../../layouts/Page.astro';
import {serviceFAQExtensions} from '../../data/faqs';
import {services,sources} from '../../data/services';
export function getStaticPaths(){return services.map(service=>({params:{slug:service.slug},props:{service}}));}
const {service:s}=Astro.props;
---
<Page title={s.title} description={s.description} image={`/images/${s.image}`} service={s.name}>
<div class="service-tabs"><div class="wrap">{services.map(item=><a href={`/services/${item.slug}/`} aria-current={item.slug===s.slug?'page':undefined}>{item.name}</a>)}</div></div>
<section class="wrap service-intro"><div class="breadcrumbs"><a href="/">Home</a><span>/</span><a href="/services/">Services</a><span>/</span><span>{s.name}</span></div><div class="service-hero-grid"><div><p class="eyebrow">{s.name.toUpperCase()} · RDB BUILDING SERVICES LTD</p><h1>{s.headline}</h1><p class="lead">{s.intro}</p><a class="button" href={`/contact/?service=${s.slug}`}>Discuss your {s.name.toLowerCase()} project <span>↗</span></a></div><figure><img src={`/images/${s.image}`} alt={s.alt} width="720" height="900" fetchpriority="high"/></figure></div></section>
<div class="wrap service-body"><aside class="contents"><p class="eyebrow">IN THIS GUIDE</p><nav aria-label="On this page">{s.sections.map(([heading],i)=><a href={`#topic-${i+1}`}>{heading}</a>)}<a href="#service-faq">Frequently asked questions</a></nav><a class="inline-link" href="/contact/">Prepare an enquiry ↗</a></aside><article class="service-article">{s.sections.map(([heading,paragraphs],i)=><section id={`topic-${i+1}`}><span class="topic-number">0{i+1}</span><h2>{heading}</h2>{(paragraphs as string[]).map(p=><p>{p}</p>)}</section>)}<section class="brief-box"><p class="eyebrow">YOUR RDB PROJECT BRIEF</p><h2>What to send us</h2><ul>{s.checklist.map(item=><li>{item}</li>)}</ul><p>RDB is based at Unit 1, Newlands Farm, Newlands Lane, Curdworth, Sutton Coldfield B76 0BE. Share your project location so access, delivery arrangements and scope can be discussed before a quotation is agreed.</p><a class="button" href="/contact/">Prepare your enquiry <span>↗</span></a></section><section id="service-faq"><p class="eyebrow">{s.name.toUpperCase()} QUESTIONS</p><h2>Frequently asked questions</h2>{[...s.faqs,...(serviceFAQExtensions[s.slug] || [])].map(([q,a])=><details><summary>{q}<span>+</span></summary><p>{a}</p></details>)}</section><section class="source-panel"><h2>Further reading</h2><p>These resources explain general requirements. Confirm the rules for your UK nation, site and intended use with the relevant authority. Specific design, approvals and installation responsibilities need to be agreed for your project.</p><ul>{s.sources.map(key=><li><a href={sources[key].url} target="_blank" rel="noopener noreferrer">{sources[key].label} ↗</a></li>)}</ul></section></article></div>
<section class="section services"><div class="wrap"><p class="eyebrow">MORE FROM RDB</p><h2>Explore a related service</h2><div class="related-services">{services.filter(item=>item.slug!==s.slug).map(item=><a href={`/services/${item.slug}/`}><span>{item.name}</span><span>↗</span></a>)}</div></div></section>
</Page>
